# Banco de dados (PostgreSQL local ou Supabase)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/coisas_brasileiras

# Site
NEXT_PUBLIC_SITE_URL=https://seu-site.com

# Dominio que serve a marca "branco" (Porcelanas Brancas) - qualquer outro
# host (incluindo o dominio principal e localhost) cai na marca "colorido"
# (Coisas Brasileiras). Sem essa variavel, o sistema so serve "colorido" e o
# atalho pro Porcelanas Brancas nao aparece no cabecalho do admin.
DOMINIO_BRANCO=porcelanasbrancas.com

# As credenciais de integracao abaixo (Mercado Pago, Email, Bling, Frenet)
# tambem podem ser preenchidas direto pelo admin em Configuracoes >
# Integracoes, sem precisar editar este arquivo - o que estiver salvo no
# banco tem prioridade, essas variaveis aqui sao so o fallback (util em dev
# local ou antes do primeiro deploy). O Cloudinary abaixo e excecao: fica so
# nas variaveis de ambiente mesmo, nao tem campo no admin.

# Autenticacao (gere um valor aleatorio, ex: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-valor-aleatorio-longo

# Mercado Pago (painel de developers > sua aplicacao > credenciais)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx
# Painel de developers > sua aplicacao > Webhooks > "Assinatura secreta" (so existe depois de configurar a URL do webhook)
MERCADOPAGO_WEBHOOK_SECRET=

# Email (Gmail) - gere uma "senha de app" em myaccount.google.com/apppasswords
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=senha-de-app-de-16-digitos
# Para onde vao as notificacoes internas (novo pedido pago) - opcional, cai pro EMAIL_USER acima se nao definido
EMAIL_NOTIFICACOES_ADMIN=

# Bling (developer.bling.com.br) - so emissao de NF-e, botao manual no pedido
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Frenet (frenet.com.br) - cotacao real de frete por CEP, com varias
# transportadoras/servicos pro cliente escolher no checkout. Opcional.
# Token gerado no painel da conta Frenet. Sem isso configurado (+ CEP de
# origem em Configuracoes > Frete), o frete cai automaticamente na tabela de
# faixas por regiao/peso cadastrada no admin.
FRENET_TOKEN=
# So mude se a Frenet indicar uma URL de homologacao/teste diferente
FRENET_API_URL=https://api.frenet.com.br

# Cloudinary (opcional) - so necessario se o site for hospedado em ambiente
# serverless (Vercel etc), sem disco persistente. Em VPS (Hostinger) com
# disco persistente, deixe em branco - o upload cai pro disco local de graca.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
