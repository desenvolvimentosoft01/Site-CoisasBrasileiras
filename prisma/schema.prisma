// Schema do banco de dados do e-commerce Coisas Brasileiras
// Padrao de nomenclatura das tabelas: prefixo TAB_ + nome no singular (ex: TAB_PRODUTO)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Catalogo ----------

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  produtos ProdutoCategoria[]

  @@map("TAB_CATEGORIA")
}

model Produto {
  id                String   @id @default(uuid())
  nome              String
  slug              String   @unique
  descricao         String?
  preco             Decimal  @db.Decimal(10, 2)
  precoPromocional  Decimal? @db.Decimal(10, 2)
  estoque           Int      @default(0)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  categorias ProdutoCategoria[]
  imagens    ProdutoImagem[]
  itensPedido ItemPedido[]

  @@map("TAB_PRODUTO")
}

// Relacionamento N:N entre produto e categoria
model ProdutoCategoria {
  produtoId   String
  categoriaId String

  produto   Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([produtoId, categoriaId])
  @@map("TAB_PRODUTO_CATEGORIA")
}

model ProdutoImagem {
  id        String  @id @default(uuid())
  produtoId String
  url       String
  ordem     Int     @default(0)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("TAB_PRODUTO_IMAGEM")
}

// ---------- Cliente ----------

model Cliente {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  telefone   String?
  cpfCnpj    String?  @unique
  senhaHash  String
  criadoEm   DateTime @default(now())

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("TAB_CLIENTE")
}

model Endereco {
  id           String  @id @default(uuid())
  clienteId    String
  cep          String
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  principal    Boolean @default(false)

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@map("TAB_ENDERECO")
}

// ---------- Pedido ----------

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Pedido {
  id              String       @id @default(uuid())
  clienteId       String
  enderecoId      String
  status          StatusPedido @default(AGUARDANDO_PAGAMENTO)
  total           Decimal      @db.Decimal(10, 2)
  formaPagamento  String?
  notaFiscalUrl   String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt

  cliente  Cliente    @relation(fields: [clienteId], references: [id])
  endereco Endereco   @relation(fields: [enderecoId], references: [id])
  itens    ItemPedido[]

  @@map("TAB_PEDIDO")
}

model ItemPedido {
  id             String  @id @default(uuid())
  pedidoId       String
  produtoId      String
  quantidade     Int
  precoUnitario  Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("TAB_PEDIDO_ITEM")
}

// ---------- Administracao ----------

enum PapelUsuarioAdmin {
  ADMIN
  OPERADOR
}

model UsuarioAdmin {
  id         String            @id @default(uuid())
  nome       String
  email      String            @unique
  senhaHash  String
  papel      PapelUsuarioAdmin @default(OPERADOR)
  ativo      Boolean           @default(true)
  criadoEm   DateTime          @default(now())

  @@map("TAB_USUARIO_ADMIN")
}
